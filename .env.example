# ─────────── Supabase Postgres (Prisma) ───────────
# Runtime connection. On Vercel use the Transaction pooler (port 6543):
#   Supabase dashboard → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Migrations only — always the direct (unpooled) connection.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─────────── Supabase Auth ───────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[PUBLISHABLE-OR-ANON-KEY]"

# Server-only. Never expose to the browser, never commit.
SUPABASE_SECRET_KEY="[SECRET-OR-SERVICE-ROLE-KEY]"
