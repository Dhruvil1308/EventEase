# ─────────── Supabase Postgres (Prisma) ───────────
# Runtime connection. On Vercel use the Transaction pooler (port 6543):
#   Supabase dashboard → Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations need the full protocol, so they use the SESSION pooler (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────── Supabase Auth ───────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[PUBLISHABLE-OR-ANON-KEY]"

# Server-only. Never expose to the browser, never commit.
SUPABASE_SECRET_KEY="[SECRET-OR-SERVICE-ROLE-KEY]"

# Optional. Times on screen and in reminder calls use this zone.
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# ─────────── Aanaya reminder calls (outbound only) ───────────
# Sarvam AI — Bulbul v3 text-to-speech and Saaras v3 speech-to-text. https://dashboard.sarvam.ai
SARVAM_API_KEY=""
# Optional voice overrides (Bulbul v3 speakers). Defaults: priya (Hindi, Gujarati), ishita (English).
# SARVAM_SPEAKER=""
# SARVAM_SPEAKER_HI=""
# SARVAM_SPEAKER_GU=""
# SARVAM_SPEAKER_EN=""

# OpenAI — polishes the script and understands replies. Optional: without it
# Aanaya uses fixed scripts and keyword matching.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Vobiz — the Indian number that places the calls. Console → API credentials.
VOBIZ_AUTH_ID=""
VOBIZ_AUTH_TOKEN=""
# Your Vobiz number, e.g. 918071234567
VOBIZ_FROM_NUMBER=""

# Local development only: the ngrok tunnel Vobiz uses to reach your machine.
# `npm run dev:calls` starts the app and the tunnel together; the app finds the
# tunnel itself. Token and free static domain: https://dashboard.ngrok.com
NGROK_AUTHTOKEN=""
NGROK_DOMAIN=""   # e.g. your-name.ngrok-free.dev

# Public HTTPS URL Vobiz can reach for its webhooks. Leave empty in development
# (the running ngrok tunnel is used). In production, set it to your domain.
PUBLIC_BASE_URL=""

# Signs webhook URLs. Optional: derived from SUPABASE_SECRET_KEY when empty.
VOICE_WEBHOOK_SECRET=""

# Production scheduler: call GET /api/cron/reminders every minute with
# `Authorization: Bearer $CRON_SECRET`. Locally the app runs it every 30 s itself
# (set REMINDER_SCHEDULER=off to stop that).
CRON_SECRET=""
