// EventEase — data model
// Postgres (Supabase). Identity lives in Supabase Auth (auth.users); every
// auth user has exactly one Profile here, and the Profile's role decides which
// portal they belong to.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATTENDEE
  HOST
}

/// Mirrors a Supabase `auth.users` row. `id` IS the auth user id, so a session
/// maps to a profile without a lookup table. Role is fixed at sign-up: an
/// account is either an attendee or a host, never both.
model Profile {
  id    String @id @db.Uuid
  email String @unique
  name  String
  role  Role

  // Host-only
  organization String?

  // Attendee-only
  studentId  String?
  department String?
  phone      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostedEvents  Event[]
  registrations Registration[]

  @@index([role])
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  venue       String
  startsAt    DateTime
  capacity    Int
  // Visual theme used for cards, tickets and the 3D accents (see src/lib/themes.ts)
  theme       String   @default("aurora")
  // The host account that owns this event. Only they can edit it or run its gate.
  hostId      String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host          Profile        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  registrations Registration[]
  checkInLogs   CheckInLog[]

  @@index([startsAt])
  @@index([hostId])
}

model Registration {
  id      String @id @default(cuid())
  eventId String
  // The attendee account that holds this ticket.
  userId  String @db.Uuid

  // Snapshot of the attendee's details at registration time, so a later profile
  // edit never rewrites history on an already-issued ticket.
  name       String
  email      String
  studentId  String?
  department String?

  // Human-friendly unique entry code, also encoded in the QR (e.g. EE-7K2M-Q9XD)
  code        String    @unique
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInLogs CheckInLog[]

  // One ticket per account per event — the duplicate-registration guard.
  @@unique([eventId, userId])
  @@unique([eventId, email])
  @@index([eventId, checkedInAt])
  @@index([userId])
}

// Every scan / manual entry at the gate is recorded, including rejected ones,
// so organizers can audit duplicate or invalid attempts.
model CheckInLog {
  id             String   @id @default(cuid())
  // SUCCESS | DUPLICATE | INVALID | WRONG_EVENT
  result         String
  code           String
  eventId        String?
  registrationId String?
  createdAt      DateTime @default(now())

  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}
